# Save the Supabase CA certificate as supabase-ca.crt in the project root.
# Supabase Transaction Pooler (port 6543) for the application runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&sslmode=verify-full&sslrootcert=./supabase-ca.crt"
# Supabase Session Pooler (port 5432) for Prisma CLI commands and migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full&sslrootcert=./supabase-ca.crt"
# Minimal 12 karakter.
ADMIN_PASSWORD="GANTI_DENGAN_RAHASIA_KUAT"
ADMIN_SESSION_SECRET="GANTI_DENGAN_RAHASIA_ACAK_MINIMAL_32_BYTE"
# Minimal 32 byte acak. Dipakai HMAC token QR dinamis; jangan pernah dikirim ke client.
QR_SIGNING_SECRET="GANTI_DENGAN_RAHASIA_ACAK_MINIMAL_32_BYTE"
# Nilai produksi di Vercel: https://natal-pwk-unnes-2026.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

